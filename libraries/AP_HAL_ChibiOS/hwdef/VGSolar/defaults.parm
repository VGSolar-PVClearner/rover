# VGSolar 项目板级默认参数。
# 固化 VGSolar 车型的固定接口、功能和安全行为。
# 包含与代码默认值相同但属于项目基线的参数，避免上游默认值变化改变整车行为。
# 不写入 IMU、罗盘、编码器 CPR、轮径和安装位置等单机校准参数。

# VGSolar 模式的默认行驶与超声波安全带。
VGS_ENABLE 1
VGS_CRUISE_SPD 1
VGS_TURN_TO 15
VGS_TURN_SPD 0.3
VGS_RF_MAX 15

# NCU 伴生机接口。
CC_ENABLE 1
CC_PORT 0
CC_LOG 1

# 固定串口用途，以项目地面站参数配置和 IO 资源分配文档为准。
# SERIAL2 波特率由实际数传模块决定，SERIAL7 波特率由实际 GPS 型号决定，因此不写死。
SERIAL0_PROTOCOL 2
SERIAL1_PROTOCOL 23
SERIAL1_BAUD 115
SERIAL1_OPTIONS 0
SERIAL2_PROTOCOL 2
SERIAL2_OPTIONS 0
SERIAL3_PROTOCOL -1
SERIAL4_PROTOCOL 9
SERIAL4_BAUD 9
SERIAL4_OPTIONS 0
SERIAL5_PROTOCOL 9
SERIAL5_BAUD 9
SERIAL5_OPTIONS 0
SERIAL6_PROTOCOL 50
SERIAL6_BAUD 115
SERIAL6_OPTIONS 0
SERIAL7_PROTOCOL 5
SERIAL7_OPTIONS 0
SERIAL8_PROTOCOL 51
SERIAL8_BAUD 115
SERIAL8_OPTIONS 0

# 默认启用四台 2BLD6010 RS485 遥测；按项目 Modbus 地址顺序轮询。
BESC_ENABLE 1
BESC_NUM 4
BESC_ADDR1 2
BESC_ADDR2 1
BESC_ADDR3 3
BESC_ADDR4 4
BESC_OFS 0
BESC_RATE 10
BESC_TIMEOUT 500

# 两路固定 DYP-A02 超声波：UART8 对应左外侧，使用量程计实例 4。
RNGFND4_TYPE 45
RNGFND4_MIN_CM 3
RNGFND4_MAX_CM 450
RNGFND4_ORIENT 7

# USART2 对应右外侧，使用量程计实例 8。
RNGFND8_TYPE 45
RNGFND8_MIN_CM 3
RNGFND8_MAX_CM 450
RNGFND8_ORIENT 1

# PWM 资源和输出功能以项目 IO 资源分配文档为准。
# PWM1/2 和 PWM7/8 用作轮编码器输入，不作为执行机构输出。
SERVO1_FUNCTION -1
SERVO2_FUNCTION -1
SERVO3_FUNCTION 73
# 左履带接线方向固定，反相后与整车前进方向一致。
SERVO3_REVERSED 1
SERVO4_FUNCTION 74
SERVO5_FUNCTION 159
SERVO6_FUNCTION 158
SERVO7_FUNCTION -1
SERVO8_FUNCTION -1
SERVO9_FUNCTION 157

# 固定轮编码器使能状态和 GPIO 分配。
# CPR、轮径、位置偏移等参数需要逐车标定，不写入板级默认参数。
WENC_TYPE 1
WENC_PINA 56
WENC_PINB 57
WENC2_TYPE 1
WENC2_PINA 51
WENC2_PINB 50

# 固定气阀和气泵 GPIO 及安全初态。
# 气阀控制为低有效：逻辑 ON 输出低电平，逻辑 OFF 输出高电平。
RELAY1_FUNCTION 1
RELAY1_PIN 59
RELAY1_INVERTED 1
RELAY1_DEFAULT 0
RELAY2_FUNCTION 1
RELAY2_PIN 60
RELAY2_INVERTED 0
RELAY2_DEFAULT 0

# 吸盘模块的固定 Relay、红外和时序配置。
SCUP_LIFT_DLY_MS 2000
SCUP_VENT_DLY_MS 2000
SCUP_ACT_TOUT_MS 30000
SCUP_LIFT_RATE 400
SCUP_VLV_RLY 0
SCUP_PUMP_RLY 1
SCUP_IR_PIN 98
SCUP_IR_POL 0
SCUP_IR_DEB_MS 30
SCUP_LIFT_TO_MS 5000

# 吸附建立与掉压判定：建立到 -70kPa 的最长等待时间为 10 秒。
SCUP_VAC_DLY_MS 10000
SCUP_VAC_P_KPA -70
SCUP_VAC_DEB_MS 300
SCUP_VAC_HYST 5

# SCUP_LIFT_PWM_R/L 是升降舵机实机端点，不固化到板级默认参数。

# MCP-H10 3.3V 吸盘负压模块：PC0/ADC 逻辑引脚 10。
# 端点来自传感器规格（0.1V=0kPa、3.1V=-100kPa），不是单机 IMU/罗盘校准。
SPRESS_PIN 10
SPRESS_V_MIN 0.1
SPRESS_V_MAX 3.1
SPRESS_P_MIN 0
SPRESS_P_MAX -100
SPRESS_FILT_HZ 5

# VGSolar 电池监视器默认参数。
#
# 主电池使用 PC4 采集电压（模拟引脚 4），使用 PA4 采集电流（模拟引脚 18）。
# ADC 通道分配由 hwdef.dat 定义。
BATT_MONITOR 4

# 6S 电池配置。即使剩余电量改为按电压计算，低电压和严重低电压阈值仍用于告警和保护。
BATT_VOLT_PIN 4
BATT_CAPACITY 4000
BATT_LOW_VOLT 21.6
BATT_CRT_VOLT 21

# 主电池电流采集 ADC 通道。
BATT_CURR_PIN 18

# VGSolar 电压和电流采样标定值，适用于本项目固定的分压与电流采样电路。
# 这组值属于项目电源采样配置，不是 IMU、罗盘等每台飞控各不相同的校准值。
BATT_VOLT_MULT 20.65
BATT_AMP_PERVLT 85
BATT_AMP_OFFSET -0.001

# 本板 BATT2 没有电流采集 ADC 通道。
BATT2_CURR_PIN -1

# 预留的 BATT3～BATT5 电流采集 ADC 通道：PC1=11、PC5=8、PB0=9。
# 对应电池监视器在显式启用前保持关闭。
BATT3_CURR_PIN 11
BATT4_CURR_PIN 8
BATT5_CURR_PIN 9

# 6S 电池剩余电量按电压计算，不再使用累计消耗的 mAh 计算。
# 25.2V 对应 100%，19.8V 对应 0%；上下限与上面的电压采样标定相互独立。
BATT_PCT_SRC 1
BATT_PCT_VMAX 25.2
BATT_PCT_VMIN 19.8
